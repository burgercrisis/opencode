{
  "$schema": "https://opencode.ai/config.json",
  // "enterprise": {
  //   "url": "https://enterprise.dev.opencode.ai",
  // },
  "provider": {
    "opencode": {
      "options": {},
    },
    "azure": {
      "api": "https://{{AZURE_OPENAI_RESOURCE_NAME|AZURE_RESOURCE_NAME}}.openai.azure.com/openai/deployments/{{AZURE_OPENAI_DEPLOYMENT_ID|AZURE_DEPLOYMENT_ID}}",
      "options": {
        "apiVersion": "2024-06-01",
      },
      "models": {
        "claude-3-5-sonnet": {
          "id": "claude-3-5-sonnet",
          "provider": {
            "npm": "@ai-sdk/anthropic",
            "api": "https://{{AZURE_OPENAI_RESOURCE_NAME|AZURE_RESOURCE_NAME}}.openai.azure.com/openai/deployments/{{AZURE_OPENAI_DEPLOYMENT_ID|AZURE_DEPLOYMENT_ID}}",
          },
        },
      },
    },
  },
  "mcp": {},
  "tools": {
    "github-triage": false,
    "github-pr-search": false,
  },
}
