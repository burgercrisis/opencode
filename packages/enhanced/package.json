{
  "name": "@opencode/enhanced",
  "version": "1.0.0",
  "description": "Enhanced OpenCode system with locality-preserving improvements",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "bun build src/index.ts --outdir dist --target node",
    "dev": "bun --watch src/index.ts",
    "test": "bun test",
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@xenova/transformers": "^2.17.2",
    "hnswlib-node": "^1.4.2",
    "kysely": "^0.28.9",
    "lru-cache": "^10.0.0",
    "better-sqlite3": "^8.7.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.8",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "@types/bun": "catalog:",
    "eslint": "^8.55.0"
  },
  "peerDependencies": {
    "opencode": "workspace:*"
  },
  "keywords": [
    "ai",
    "coding",
    "assistant",
    "locality",
    "privacy",
    "knowledge-graph",
    "vector-search"
  ],
  "author": "OpenCode Contributors",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/sst/opencode.git"
  },
  "files": [
    "dist/**/*",
    "src/**/*"
  ]
}
