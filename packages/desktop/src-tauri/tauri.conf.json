{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OpenCode-Dev",
  "identifier": "ai.opencode.desktop.dev",
  "mainBinaryName": "OpenCode",
  "version": "../package.json",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "create": false,
        "devtools": true
      }
    ],
    "withGlobalTauri": true,
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self' 'unsafe-inline'",
        "style-src": "'self' 'unsafe-inline' https://fonts.googleapis.com",
        "font-src": "'self' https://fonts.gstatic.com",
        "img-src": "'self' asset: http://asset.localhost blob: data:",
        "connect-src": "'self' ipc: http://ipc.localhost https: wss:",
        "object-src": "'none'",
        "base-uri": "'self'"
      }
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "icon": [
      "icons/dev/32x32.png",
      "icons/dev/128x128.png",
      "icons/dev/128x128@2x.png",
      "icons/dev/icon.icns",
      "icons/dev/icon.ico"
    ],
    "active": true,
    "targets": [
      "nsis"
    ],
    "externalBin": [
      "sidecars/opencode-cli-x86_64-pc-windows-msvc.exe"
    ],
    "linux": {
      "rpm": {
        "compression": {
          "type": "none"
        }
      }
    },
    "macOS": {
      "entitlements": "./entitlements.plist"
    },
    "windows": {
      "nsis": {
        "installerIcon": "icons/dev/icon.ico",
        "headerImage": "assets/nsis-header.bmp",
        "sidebarImage": "assets/nsis-sidebar.bmp"
      }
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "opencode"
        ]
      }
    }
  }
}