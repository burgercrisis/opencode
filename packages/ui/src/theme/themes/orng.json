{
  "$schema": "https://opencode.ai/desktop-theme.json",
  "name": "Orange",
  "id": "orng",
  "light": {
    "seeds": {
      "primary": "#EC5B2B",
      "neutral": "#ffffff",
      "interactive": "#c94d24",
      "success": "#0062d1",
      "warning": "#EC5B2B",
      "error": "#d1383d",
      "info": "#318795",
      "diffAdd": "#0062d1",
      "diffDelete": "#c53b53"
