{
  "$schema": "https://opencode.ai/desktop-theme.json",
  "name": "Zenburn",
  "id": "zenburn",
  "dark": {
    "seeds": {
      "primary": "#8cd0d3",
      "neutral": "#3f3f3f",
      "interactive": "#8cd0d3",
      "success": "#7f9f7f",
      "warning": "#f0dfaf",
      "error": "#cc9393",
      "info": "#dfaf8f",
      "diffAdd": "#7f9f7f",
