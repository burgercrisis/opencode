{
  "$schema": "https://opencode.ai/desktop-theme.json",
  "name": "Material",
  "id": "material",
  "light": {
    "seeds": {
      "primary": "#6182b8",
      "neutral": "#fafafa",
      "interactive": "#7c4dff",
      "success": "#91b859",
      "warning": "#ffb300",
      "error": "#e53935",
      "info": "#f4511e",
      "diffAdd": "#91b859",
      "diffDelete": "#e53935"
