      "text-weak": "#90a4ae"
    }
  },
  "dark": {
    "seeds": {
      "primary": "#82aaff",
      "neutral": "#263238",
      "interactive": "#c792ea",
      "success": "#c3e88d",
      "warning": "#ffcb6b",
      "error": "#f07178",
      "info": "#ffcb6b",
      "diffAdd": "#c3e88d",
