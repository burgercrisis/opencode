{
  "$schema": "https://opencode.ai/desktop-theme.json",
  "name": "Cursor",
  "id": "cursor",
  "light": {
    "seeds": {
      "primary": "#6f9ba6",
      "neutral": "#fcfcfc",
      "interactive": "#3c7cab",
      "success": "#1f8a65",
      "warning": "#db704b",
      "error": "#cf2d56",
      "info": "#3c7cab",
      "diffAdd": "#1f8a65",
