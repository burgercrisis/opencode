      "text-base": "#203022",
      "text-weak": "#748476"
    }
  },
  "dark": {
    "seeds": {
      "primary": "#2eff6a",
      "neutral": "#0a0e0a",
      "interactive": "#00efff",
      "success": "#62ff94",
      "warning": "#e6ff57",
      "error": "#ff4b4b",
      "info": "#30b3ff",
      "diffAdd": "#1cc24b",
      "diffDelete": "#ff4b4b"
