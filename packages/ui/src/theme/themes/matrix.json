{
  "$schema": "https://opencode.ai/desktop-theme.json",
  "name": "Matrix",
  "id": "matrix",
  "light": {
    "seeds": {
      "primary": "#1cc24b",
      "neutral": "#eef3ea",
      "interactive": "#24f6d9",
      "success": "#1cc24b",
      "warning": "#e6ff57",
      "error": "#ff4b4b",
      "info": "#30b3ff",
      "diffAdd": "#1cc24b",
      "diffDelete": "#ff4b4b"
    },
    "overrides": {
      "background-base": "#eef3ea",
