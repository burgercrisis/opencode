    "overrides": {
      "background-base": "#0a0e0a",
      "background-weak": "#0e130d",
      "background-strong": "#080b08",
      "background-stronger": "#040604",
      "text-base": "#62ff94",
      "text-weak": "#8ca391",
      "text-strong": "#2eff6a",
      "syntax-string": "#1cc24b",
      "syntax-primitive": "#ff4b4b",
      "syntax-property": "#c770ff",
      "syntax-type": "#e6ff57",
      "syntax-constant": "#00efff",
      "syntax-info": "#30b3ff"
