import { Log } from "./log"

/**
 * Standardized error handling utilities for consistent error patterns across the codebase
 */

export interface ErrorContext {
  [key: string]: string | number | boolean | undefined
}

export interface SafeAsyncResult<T> {
  success: boolean
  data?: T
  error?: string
}

export interface ValidationResult {
  valid: boolean
  error?: string
}

/**
 * Safe async function wrapper with consistent error handling
 */
export async function safeAsync<T>(
  operation: () => Promise<T>,
  context: string,
  defaultValue?: T
): Promise<SafeAsyncResult<T>> {
  try {
    const result = await operation()
    return { success: true, data: result }
  } catch (error) {
    const errorMessage = error instanceof Error ? error.message : String(error)
    Log.Default.error(`Operation failed in ${context}`, {
      error: errorMessage,
      context,
      stack: error instanceof Error ? error.stack : undefined
    })
    return { success: false, error: errorMessage }
  }
}

/**
 * Validate input parameters with consistent error messages
 */
export function validateInput(
  value: unknown,
  name: string,
  options: {
    required?: boolean
    minLength?: number
    maxLength?: number
    pattern?: RegExp
    allowedValues?: readonly unknown[]
  } = {}
): ValidationResult {
  if (value === undefined || value === null) {
    const error = options.required
      ? `${name} is required`
      : `${name} cannot be null or undefined`
    return { valid: false, error }
  }

  if (typeof value === 'string' && options.minLength && value.length < options.minLength) {
    return {
      valid: false,
      error: `${name} must be at least ${options.minLength} characters`
    }
  }

  if (typeof value === 'string' && options.maxLength && value.length > options.maxLength) {
    return {
      valid: false,
      error: `${name} must not exceed ${options.maxLength} characters`
    }
  }

  if (options.pattern && typeof value === 'string' && !options.pattern.test(value)) {
    return {
      valid: false,
      error: `${name} format is invalid`
    }
  }

  if (options.allowedValues && !options.allowedValues.includes(value)) {
    return {
      valid: false,
      error: `${name} must be one of: ${options.allowedValues.join(', ')}`
    }
  }

  return { valid: true }
}

/**
 * Create a standardized error object
 */
export function createError(
  message: string,
  context: ErrorContext = {}
): Error & { context: ErrorContext } {
  const error = new Error(message) as Error & { context: ErrorContext }
  error.context = context
  return error
}

/**
 * Log warning with context information
 */
export function logWarning(message: string, context: ErrorContext = {}): void {
  Log.Default.warn(message, {
    context,
    timestamp: new Date().toISOString()
  })
}

/**
 * Log error with context information
 */
export function logError(message: string, context: ErrorContext = {}): void {
  Log.Default.error(message, {
    context,
    timestamp: new Date().toISOString(),
    stack: new Error().stack
  })
}
